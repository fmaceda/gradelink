{
  "name": "gradelink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev:api": "npm run dev -w @gradelink/api",
    "dev:web": "npm run dev -w @gradelink/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @gradelink/shared && npm run build -w @gradelink/web && npm run build -w @gradelink/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "~6.0.3"
  }
}
